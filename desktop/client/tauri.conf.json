{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Repo Go",
  "identifier": "io.github.drflgd.gamerepo.go",
  "build": {
    "frontendDist": "../../build/desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Game Repo Go",
        "url": "client.html",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Download games from your Game Repo library into ES-DE",
    "longDescription": "Browse a Game Repo library served on your home network, download games with their pictures and manuals into ES-DE's folders on this device, and remove them again safely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 29
    }
  }
}
