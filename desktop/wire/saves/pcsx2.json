{
  "format": 1,
  "id": "pcsx2",
  "name": "PCSX2",
  "about": "PCSX2 on Windows, Linux and the Steam Deck. Its memory cards are files every game shares (kept as one save), or folders with a folder for each game's save; states are in sstates by the disc's serial.",
  "kind": "folders",
  "save_format": "pcsx2",
  "state_format": "pcsx2:PCSX2",
  "processes": [
    "pcsx2-qt.exe",
    "pcsx2-qtx64.exe",
    "pcsx2-qtx64-avx2.exe",
    "pcsx2-qt",
    "pcsx2"
  ],
  "roots": {
    "windows": [
      "{documents}/PCSX2",
      "{home}/OneDrive/Documents/PCSX2"
    ],
    "linux": [
      "{home}/.var/app/net.pcsx2.PCSX2/config/PCSX2",
      "{config}/PCSX2"
    ]
  },
  "look_for": [
    "memcards",
    "sstates"
  ],
  "systems": [
    "ps2"
  ],
  "spots": [
    {
      "kind": "save",
      "files": [
        "memcards/*.ps2",
        "memcards/*.mc2"
      ],
      "whole": true
    },
    {
      "kind": "save",
      "files": [
        "memcards/*.ps2/B?{id}*/*"
      ]
    },
    {
      "kind": "state",
      "files": [
        "sstates/{id} (*).{slot}.p2s"
      ]
    }
  ],
  "textures": {
    "*": "textures/{id}/replacements/"
  },
  "textures_setting": "Graphics › Texture Replacement › Load Textures"
}
