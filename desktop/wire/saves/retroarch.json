{
  "format": 1,
  "id": "retroarch",
  "name": "RetroArch",
  "about": "RetroArch and its cores, as ES-DE starts them on Windows, Linux, the Steam Deck (as a plain install, EmuDeck's or RetroDECK's) and Android. Its retroarch.cfg says where saves and states go (savefile_directory, savestate_directory) and whether they're sorted into folders by the game's folder or by core; saves are named after the game's file.",
  "kind": "retroarch",
  "save_format": "retroarch",
  "processes": ["retroarch", "retroarch.exe"],
  "configs": {
    "windows": [
      "{appdata}/RetroArch/retroarch.cfg",
      "C:/RetroArch-Win64/retroarch.cfg",
      "C:/RetroArch/retroarch.cfg",
      "{appdata}/EmuDeck/Emulators/RetroArch/retroarch.cfg",
      "{home}/scoop/apps/retroarch/current/retroarch.cfg"
    ],
    "linux": [
      "{home}/.var/app/net.retrodeck.retrodeck/config/retroarch/retroarch.cfg",
      "{home}/.var/app/org.libretro.RetroArch/config/retroarch/retroarch.cfg",
      "{config}/retroarch/retroarch.cfg",
      "{home}/.local/share/Steam/steamapps/common/RetroArch/retroarch.cfg"
    ],
    "android": [
      "{home}/Android/data/com.retroarch/files/retroarch.cfg",
      "{home}/Android/data/com.retroarch.aarch64/files/retroarch.cfg",
      "{home}/RetroArch/retroarch.cfg"
    ]
  },
  "saves_folders": {
    "android": ["{home}/RetroArch/saves"]
  },
  "states_folders": {
    "android": ["{home}/RetroArch/states"]
  },
  "saves": [".srm", ".rtc", ".sav"],
  "state": ".state{slot}",
  "state_extras": [".png"],
