{
  "format": 1,
  "id": "knulli",
  "version": 1,
  "name": "Knulli",
  "about": "Knulli's SHARE partition: a folder per system in roms/ (names are case-sensitive), with its gamelist.xml and pictures beside the games. BIOS files go in bios/.",
  "places": [
    {
      "id": "card",
      "label": "The SD card's SHARE partition",
      "example": "E:\\"
    }
  ],
  "systems": {
    "genesis": "megadrive",
    "sg-1000": "sg1000",
    "atarilynx": "lynx",
    "atarijaguar": "jaguar",
    "atarijaguarcd": "jaguarcd",
    "wonderswan": "wswan",
    "wonderswancolor": "wswanc",
    "cdimono1": "cdi",
    "gc": "gamecube"
  },
  "games": {
    "path": "{card}/roms/{folder}/{file}",
    "style": "frontend"
  },
  "gamelist": {
    "kind": "es-xml",
    "path": "{card}/roms/{folder}/gamelist.xml",
    "fields": {
      "description": "desc",
      "developer": "developer",
      "publisher": "publisher",
      "released": "releasedate",
      "genres": "genre",
      "players": "players",
      "rating": "rating"
    }
  },
  "media": {
    "cover": {
      "path": "{card}/roms/{folder}/images/{stem}-thumb.{ext}",
      "tag": "thumbnail"
    },
    "screenshot": {
      "path": "{card}/roms/{folder}/images/{stem}-image.{ext}",
      "tag": "image"
    },
    "marquee": {
      "path": "{card}/roms/{folder}/images/{stem}-marquee.{ext}",
      "tag": "marquee"
    },
    "video": {
      "path": "{card}/roms/{folder}/videos/{stem}-video.{ext}",
      "tag": "video"
    },
    "manual": {
      "path": "{card}/roms/{folder}/manuals/{stem}-manual.pdf",
      "tag": "manual"
    }
  },
  "text": {},
  "pictures": {
    "max": 640,
    "as": "keep"
  },
  "collection": null,
  "bios": {
    "path": "{card}/bios/{bios_file}"
  }
}
