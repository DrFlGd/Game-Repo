{
  "format": 1,
  "id": "rocknix",
  "version": 3,
  "name": "ROCKNIX",
  "about": "ROCKNIX's games card: a folder per system in roms/ (/storage/roms on the device), with its gamelist.xml and pictures beside the games. ROCKNIX keeps custom collections in its storage partition, which Windows can't write, so a collection's groups can go in folders of their own instead. BIOS files go in roms/bios/. RetroArch's saves are beside the games, its states in roms/savestates/, a folder per system.",
  "places": [
    {
      "id": "card",
      "label": "The SD card (its games partition)",
      "example": "E:\\"
    }
  ],
  "systems": {
    "gc": "gamecube",
    "neogeocd": "neocd"
  },
  "games": {
    "path": "{card}/roms/{folder}/{group}/{file}",
    "style": "frontend"
  },
  "saves": {
    "files": "",
    "states": "{card}/roms/savestates/{folder}"
  },
  "gamelist": {
    "kind": "es-xml",
    "path": "{card}/roms/{folder}/gamelist.xml",
    "fields": {
      "description": "desc",
      "developer": "developer",
      "publisher": "publisher",
      "released": "releasedate",
      "genres": "genre",
      "players": "players",
      "rating": "rating"
    }
  },
  "media": {
    "cover": {
      "path": "{card}/roms/{folder}/images/{group}/{stem}-thumb.{ext}",
      "tag": "thumbnail"
    },
    "screenshot": {
      "path": "{card}/roms/{folder}/images/{group}/{stem}-image.{ext}",
      "tag": "image"
    },
    "marquee": {
      "path": "{card}/roms/{folder}/images/{group}/{stem}-marquee.{ext}",
      "tag": "marquee"
    },
    "video": {
      "path": "{card}/roms/{folder}/videos/{group}/{stem}-video.{ext}",
      "tag": "video"
    },
    "manual": {
      "path": "{card}/roms/{folder}/manuals/{group}/{stem}-manual.pdf",
      "tag": "manual"
    }
  },
  "text": {},
  "pictures": {
    "max": 640,
    "as": "keep"
  },
  "collection": null,
  "bios": {
    "path": "{card}/roms/bios/{bios_file}"
  }
}
