{
  "format": 1,
  "id": "esde",
  "version": 1,
  "name": "ES-DE",
  "about": "ES-DE on this computer: each system's games in its folder in ES-DE's ROMs folder, its gamelist and media in ES-DE's own folder, and the collection as an ES-DE custom collection.",
  "places": [
    {
      "id": "roms",
      "label": "ES-DE's ROMs folder",
      "example": "C:\\Users\\you\\ROMs"
    },
    {
      "id": "esde",
      "label": "ES-DE's own folder",
      "example": "C:\\Users\\you\\ES-DE",
      "optional": true,
      "note": "With it, each game gets an entry in its system's gamelist.xml (entries there already are kept) and the collection becomes an ES-DE custom collection."
    },
    {
      "id": "media",
      "label": "ES-DE's media folder",
      "from": "{esde}/downloaded_media",
      "es_setting": "MediaDirectory"
    }
  ],
  "systems": {},
  "games": {
    "path": "{roms}/{folder}/{file}",
    "style": "frontend"
  },
  "gamelist": {
    "kind": "es-xml",
    "path": "{esde}/gamelists/{folder}/gamelist.xml",
    "fields": {
      "description": "desc",
      "developer": "developer",
      "publisher": "publisher",
      "released": "releasedate",
      "genres": "genre",
      "players": "players",
      "rating": "rating"
    }
  },
  "media": {
    "cover": {
      "path": "{media}/{folder}/covers/{stem}.{ext}"
    },
    "back": {
      "path": "{media}/{folder}/backcovers/{stem}.{ext}"
    },
    "box3d": {
      "path": "{media}/{folder}/3dboxes/{stem}.{ext}"
    },
    "screenshot": {
      "path": "{media}/{folder}/screenshots/{stem}.{ext}"
    },
    "titlescreen": {
      "path": "{media}/{folder}/titlescreens/{stem}.{ext}"
    },
    "marquee": {
      "path": "{media}/{folder}/marquees/{stem}.{ext}"
    },
    "fanart": {
      "path": "{media}/{folder}/fanart/{stem}.{ext}"
    },
    "physical": {
      "path": "{media}/{folder}/physicalmedia/{stem}.{ext}"
    },
    "video": {
      "path": "{media}/{folder}/videos/{stem}.{ext}"
    },
    "manual": {
      "path": "{media}/{folder}/manuals/{stem}.pdf"
    }
  },
  "text": {},
  "pictures": {
    "max": 0,
    "as": "keep"
  },
  "collection": "esde-cfg",
  "bios": null
}
