{
  "format": 1,
  "id": "esde-card",
  "version": 2,
  "name": "ES-DE on Android or Linux",
  "about": "An SD card for ES-DE on an Android or Linux device: the games in ROMs/, and ES-DE's gamelists and media in ES-DE/ on the card, to copy to the device's ES-DE folder or to point ES-DE's media folder at. BIOS files go in BIOS/, for RetroArch's system folder, and the collection (each of its groups) becomes an ES-DE custom collection in ES-DE/collections/.",
  "places": [
    {
      "id": "card",
      "label": "The SD card",
      "example": "E:\\"
    }
  ],
  "systems": {},
  "games": {
    "path": "{card}/ROMs/{folder}/{group}/{file}",
    "style": "frontend"
  },
  "gamelist": {
    "kind": "es-xml",
    "path": "{card}/ES-DE/gamelists/{folder}/gamelist.xml",
    "fields": {
      "description": "desc",
      "developer": "developer",
      "publisher": "publisher",
      "released": "releasedate",
      "genres": "genre",
      "players": "players",
      "rating": "rating"
    }
  },
  "media": {
    "cover": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/covers/{group}/{stem}.{ext}"
    },
    "back": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/backcovers/{group}/{stem}.{ext}"
    },
    "box3d": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/3dboxes/{group}/{stem}.{ext}"
    },
    "screenshot": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/screenshots/{group}/{stem}.{ext}"
    },
    "titlescreen": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/titlescreens/{group}/{stem}.{ext}"
    },
    "marquee": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/marquees/{group}/{stem}.{ext}"
    },
    "fanart": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/fanart/{group}/{stem}.{ext}"
    },
    "physical": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/physicalmedia/{group}/{stem}.{ext}"
    },
    "video": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/videos/{group}/{stem}.{ext}"
    },
    "manual": {
      "path": "{card}/ES-DE/downloaded_media/{folder}/manuals/{group}/{stem}.pdf"
    }
  },
  "text": {},
  "pictures": {
    "max": 640,
    "as": "keep"
  },
  "collection": "esde-cfg",
  "es_de": "{card}/ES-DE",
  "groups": {
    "system": "{folder}-{group}"
  },
  "bios": {
    "path": "{card}/BIOS/{bios_file}"
  }
}
