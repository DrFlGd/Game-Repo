    },
    "fanart": {
      "path": "{launchbox}/Images/{folder}/Fanart - Background/{label}-01.{ext}"
    },
    "physical": {
      "path": "{launchbox}/Images/{folder}/Cart - Front/{label}-01.{ext}"
    },
    "video": {
      "path": "{launchbox}/Videos/{folder}/{label}-01.{ext}",
      "tag": "VideoPath"
    },
    "manual": {
      "path": "{launchbox}/Manuals/{folder}/{label}-01.pdf",
      "tag": "ManualPath"
    }
  },
