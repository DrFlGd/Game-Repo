  "games": {
    "path": "{launchbox}/Games/{folder}/{file}",
    "style": "frontend"
  },
  "gamelist": {
    "kind": "launchbox",
    "path": "{launchbox}/Data/Platforms/{folder}.xml",
    "fields": {
      "description": "Notes",
      "developer": "Developer",
      "publisher": "Publisher",
      "released": "ReleaseDate",
      "genres": "Genre",
      "players": "MaxPlayers",
      "rating": "CommunityStarRating"
    }
  },
