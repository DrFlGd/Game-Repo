{
  "format": 1,
  "id": "folder",
  "version": 1,
  "name": "Plain folder",
  "about": "A plain folder: each system's games in a folder named as its DAT (Nintendo - Game Boy), named as Settings › Naming says, with pictures and documents beside each game in a folder of its name.",
  "places": [
    {
      "id": "out",
      "label": "The folder",
      "example": "D:\\Collections\\Best of"
    }
  ],
  "systems": {},
  "games": {
    "path": "{out}/{dat_name}/{file}",
    "style": "naming"
  },
  "gamelist": null,
  "media": {
    "cover": {
      "path": "{out}/{dat_name}/{stem}/cover.{ext}"
    },
    "back": {
      "path": "{out}/{dat_name}/{stem}/back.{ext}"
    },
    "box3d": {
      "path": "{out}/{dat_name}/{stem}/box3d.{ext}"
    },
    "screenshot": {
      "path": "{out}/{dat_name}/{stem}/screenshot.{ext}"
    },
    "titlescreen": {
      "path": "{out}/{dat_name}/{stem}/titlescreen.{ext}"
    },
    "marquee": {
      "path": "{out}/{dat_name}/{stem}/marquee.{ext}"
    },
    "fanart": {
      "path": "{out}/{dat_name}/{stem}/fanart.{ext}"
    },
    "physical": {
      "path": "{out}/{dat_name}/{stem}/physical.{ext}"
    },
    "video": {
      "path": "{out}/{dat_name}/{stem}/video.{ext}"
    },
    "manual": {
      "path": "{out}/{dat_name}/{stem}/{doc_file}"
    }
  },
  "text": {},
  "documents": {
    "path": "{out}/{dat_name}/{stem}/docs/{doc_file}"
  },
  "pictures": {
    "max": 0,
    "as": "keep"
  },
  "collection": null,
  "bios": {
    "path": "{out}/BIOS/{dat_name}/{bios_file}"
  }
}
