{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Repo",
  "version": "0.2.0",
  "identifier": "io.github.drflgd.gamerepo",
  "build": {
    "frontendDist": "../../build/desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Game Repo",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Organise large collections of video games",
    "longDescription": "Audit ROM sets against DAT files, build and export collections, import PC games into a common layout, and keep each game's scraped details, pictures and documents in one library folder.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
